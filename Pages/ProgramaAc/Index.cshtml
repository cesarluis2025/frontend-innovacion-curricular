@page
@model FrontendInnovacionCurricular.Pages.ProgramaAc.IndexModel
@{ ViewData["Title"] = "Programas y áreas de conocimiento"; }
<header class="titulo">
    <h1>Programas y áreas de conocimiento</h1>
    <a class="boton principal" href="/ProgramaAc/Crear">+ Nueva asignación de área</a>
</header>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }

<div class="tabla">
<table>
    <thead><tr><th>Programa</th><th>Área de conocimiento</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.ProgramaNombre</td><td>@item.AreaConocimientoNombre</td>
                <td class="acciones">
                    
                    <form method="post" asp-page-handler="Retirar" asp-route-a="@item.Programa" asp-route-b="@item.AreaConocimiento" style="display:inline" onsubmit="return confirm('¿Retirar esta asignación?');">
                        <button type="submit">Retirar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
