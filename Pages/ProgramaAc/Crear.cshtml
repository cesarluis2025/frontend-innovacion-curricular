@page
@model FrontendInnovacionCurricular.Pages.ProgramaAc.CrearModel
@{ ViewData["Title"] = "Nueva asignación de área"; }
<h1>Nueva asignación de área</h1>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error"><svg class="ico" aria-hidden="true"><use href="#i-alerta"/></svg><span>@Model.MensajeError</span></div> }
<form method="post">
    <div><label asp-for="Registro.Programa">Programa</label><select asp-for="Registro.Programa" asp-items="Model.ListaPrograma" required><option value="">Seleccione…</option></select></div>
    <div><label asp-for="Registro.AreaConocimiento">Área de conocimiento</label><select asp-for="Registro.AreaConocimiento" asp-items="Model.ListaAreaConocimiento" required><option value="">Seleccione…</option></select></div>
    <div class="barra">
        <button type="submit"><svg class="ico" aria-hidden="true"><use href="#i-guardar"/></svg> Guardar</button>
        <a class="boton" href="/ProgramaAc"><svg class="ico" aria-hidden="true"><use href="#i-atras"/></svg> Cancelar</a>
    </div>
</form>
