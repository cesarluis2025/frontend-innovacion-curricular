@page
@model FrontendInnovacionCurricular.Pages.Pasantia.CrearModel
@{ ViewData["Title"] = "Nueva pasantía"; }
<h1>Nueva pasantía</h1>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }
<form method="post">
    <div><label asp-for="Registro.Id">Código</label><input asp-for="Registro.Id" type="number" required /></div>
    <div><label asp-for="Registro.Nombre">Nombre</label><input asp-for="Registro.Nombre" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.Pais">País</label><input asp-for="Registro.Pais" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.Empresa">Empresa</label><input asp-for="Registro.Empresa" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.Descripcion">Descripción</label><input asp-for="Registro.Descripcion" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.Programa">Programa</label><select asp-for="Registro.Programa" asp-items="Model.ListaPrograma" required><option value="">Seleccione…</option></select></div>
    <button type="submit">Guardar</button>
    <a class="boton" href="/Pasantia">Cancelar</a>
</form>
