@page
@model FrontendInnovacionCurricular.Pages.Pasantia.IndexModel
@{ ViewData["Title"] = "Pasantías"; }
<header class="titulo">
    <div class="titulo-txt"><span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-pasantia"/></svg></span><h1>Pasantías</h1></div>
    <a class="boton principal" href="/Pasantia/Crear"><svg class="ico" aria-hidden="true"><use href="#i-mas"/></svg> Nueva pasantía</a>
</header>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error"><svg class="ico" aria-hidden="true"><use href="#i-alerta"/></svg><span>@Model.MensajeError</span></div> }

<div class="tabla">
<table>
    <thead><tr><th>Código</th><th>Nombre</th><th>País</th><th>Empresa</th><th>Programa</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.Id</td><td>@item.Nombre</td><td>@item.Pais</td><td>@item.Empresa</td><td>@item.ProgramaNombre</td>
                <td class="acciones">
                    <a class="btn-icono" href="/Pasantia/Editar/@item.Id"><svg class="ico" aria-hidden="true"><use href="#i-lapiz"/></svg> Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Id" style="display:inline" data-confirmar="¿Retirar este registro?">
                        <button type="submit"><svg class="ico" aria-hidden="true"><use href="#i-basura"/></svg> Retirar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
