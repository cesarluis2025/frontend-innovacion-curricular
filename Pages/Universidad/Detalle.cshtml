@page "{id:int}"
@model FrontendInnovacionCurricular.Pages.Universidad.DetalleModel
@{ ViewData["Title"] = "Detalle"; }
<p><a class="volver" href="/Universidad"><svg class="ico" aria-hidden="true"><use href="#i-atras"/></svg> Volver a la lista</a></p>
<div class="titulo-txt" style="margin-bottom:1rem"><span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-universidad"/></svg></span><h1>@Model.Maestro.Nombre</h1></div>

<section>
    <h2>Facultades de esta universidad</h2>
    @if (Model.Facultades.Count == 0) { <p>Todavía no hay registros.</p> }
    else
    {
        <div class="tabla">
<table>
            <thead><tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Programas activos</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Facultades)
                {
                    <tr><td>@item.Id</td><td>@item.Nombre</td><td>@item.Tipo</td><td>@item.TotalProgramas</td></tr>
                }
            </tbody>
        </table>
</div>
    }
    <h3>Agregar varias filas</h3>
    @if (Model.SeccionConError == "Facultades" && !string.IsNullOrEmpty(Model.MensajeError)) { <div class="error"><svg class="ico" aria-hidden="true"><use href="#i-alerta"/></svg><span>@Model.MensajeError</span></div> }
    <form method="post" asp-page-handler="Facultades" asp-route-id="@Model.Maestro.Id">
        <div class="tabla">
<table id="tablaFacultades" class="filas">
            <thead><tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Fecha de fundación</th></tr></thead>
            <tbody>
                @for (var i = 0; i < Model.NuevasFacultades.Count; i++)
                {
                    <tr><td><input asp-for="NuevasFacultades[i].Id" type="number" /></td><td><input asp-for="NuevasFacultades[i].Nombre" type="text" maxlength="60" /></td><td><input asp-for="NuevasFacultades[i].Tipo" type="text" maxlength="45" /></td><td><input asp-for="NuevasFacultades[i].FechaFun" type="date" /></td></tr>
                }
            </tbody>
        </table>
</div>
        <button type="button" class="agregar-fila" data-tabla="tablaFacultades"><svg class="ico" aria-hidden="true"><use href="#i-mas"/></svg> Agregar fila</button>
        <button type="submit"><svg class="ico" aria-hidden="true"><use href="#i-guardar"/></svg> Guardar todas las filas</button>
    </form>
</section>
<script src="~/js/detalle.js"></script>
