@page
@model FrontendInnovacionCurricular.Pages.Universidad.CrearModel
@{ ViewData["Title"] = "Nueva universidad"; }
<h1>Nueva universidad</h1>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }
<form method="post">
    <div><label asp-for="Registro.Id">ID</label><input asp-for="Registro.Id" type="number" /></div>
    <div><label asp-for="Registro.Nombre">Nombre</label><input asp-for="Registro.Nombre" type="text" maxlength="60" /></div>
    <div><label asp-for="Registro.Tipo">Tipo</label><input asp-for="Registro.Tipo" type="text" maxlength="45" /></div>
    <div><label asp-for="Registro.Ciudad">Ciudad</label><input asp-for="Registro.Ciudad" type="text" maxlength="45" /></div>
    <button type="submit">Guardar</button>
    <a class="boton" href="/Universidad">Cancelar</a>
</form>
