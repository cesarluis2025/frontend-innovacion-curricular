@page
@model FrontendInnovacionCurricular.Pages.Universidad.IndexModel
@{ ViewData["Title"] = "Universidad"; }
<h1>Universidad</h1>
<a class="boton boton-primario" href="/Universidad/Crear">+ Nuevo registro</a>
<table>
    <thead><tr><th>ID</th><th>Nombre</th><th>Tipo</th><th>Ciudad</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.Id</td><td>@item.Nombre</td><td>@item.Tipo</td><td>@item.Ciudad</td>
                <td class="acciones">
                    <a href="/Universidad/Editar/@item.Id">Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Id" style="display:inline" onsubmit="return confirm('¿Eliminar este registro?');">
                        <button type="submit">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
