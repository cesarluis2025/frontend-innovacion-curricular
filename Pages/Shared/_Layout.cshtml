@{
    var ruta = Context.Request.Path.Value ?? "/";
    string Act(string c) =>
        ruta.Equals("/" + c, StringComparison.OrdinalIgnoreCase) || ruta.StartsWith("/" + c + "/", StringComparison.OrdinalIgnoreCase)
            ? " class=\"activo\" aria-current=\"page\"" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Innovación Curricular</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,500;7..72,700&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <a class="saltar" href="#contenido">Ir al contenido</a>
    <div class="armazon">
        <aside class="lateral" id="lateral">
            <a class="marca" href="/">Innovación<br />Curricular</a>
            <nav aria-label="Secciones">
            <p class="grupo-titulo">Catálogos</p>
            <ul>
                <li><a href="/AreaConocimiento"@Html.Raw(Act("AreaConocimiento"))>Área de conocimiento</a></li>
                <li><a href="/AspectoNormativo"@Html.Raw(Act("AspectoNormativo"))>Aspecto normativo</a></li>
                <li><a href="/PracticaEstrategia"@Html.Raw(Act("PracticaEstrategia"))>Práctica o estrategia</a></li>
                <li><a href="/Enfoque"@Html.Raw(Act("Enfoque"))>Enfoque</a></li>
                <li><a href="/CarInnovacion"@Html.Raw(Act("CarInnovacion"))>Característica de innovación</a></li>
                <li><a href="/Aliado"@Html.Raw(Act("Aliado"))>Aliado</a></li>
            </ul>
            <p class="grupo-titulo">Estructura</p>
            <ul>
                <li><a href="/Universidad"@Html.Raw(Act("Universidad"))>Universidades</a></li>
                <li><a href="/Facultad"@Html.Raw(Act("Facultad"))>Facultades</a></li>
                <li><a href="/Programa"@Html.Raw(Act("Programa"))>Programas</a></li>
            </ul>
            <p class="grupo-titulo">Detalle del programa</p>
            <ul>
                <li><a href="/Acreditacion"@Html.Raw(Act("Acreditacion"))>Acreditaciones</a></li>
                <li><a href="/RegistroCalificado"@Html.Raw(Act("RegistroCalificado"))>Registros calificados</a></li>
                <li><a href="/ActivAcademica"@Html.Raw(Act("ActivAcademica"))>Actividades académicas</a></li>
                <li><a href="/Pasantia"@Html.Raw(Act("Pasantia"))>Pasantías</a></li>
                <li><a href="/Premio"@Html.Raw(Act("Premio"))>Premios</a></li>
            </ul>
            <p class="grupo-titulo">Asignaciones</p>
            <ul>
                <li><a href="/ProgramaAc"@Html.Raw(Act("ProgramaAc"))>Áreas de cada programa</a></li>
                <li><a href="/ProgramaPe"@Html.Raw(Act("ProgramaPe"))>Prácticas de cada programa</a></li>
                <li><a href="/ProgramaCi"@Html.Raw(Act("ProgramaCi"))>Características de cada programa</a></li>
                <li><a href="/AnPrograma"@Html.Raw(Act("AnPrograma"))>Normas de cada programa</a></li>
                <li><a href="/EnfoqueRc"@Html.Raw(Act("EnfoqueRc"))>Enfoques de cada registro</a></li>
                <li><a href="/AaRc"@Html.Raw(Act("AaRc"))>Actividades de cada registro</a></li>
                <li><a href="/DocenteDepartamento"@Html.Raw(Act("DocenteDepartamento"))>Docentes por programa</a></li>
                <li><a href="/Alianza"@Html.Raw(Act("Alianza"))>Alianzas</a></li>
            </ul>
            </nav>
        </aside>
        <div class="columna">
            <div class="barra-movil">
                <a class="marca-movil" href="/">Innovación Curricular</a>
                <button type="button" id="botonMenu" aria-controls="lateral" aria-expanded="false">Menú</button>
            </div>
            <main id="contenido">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/js/site.js"></script>
</body>
</html>
