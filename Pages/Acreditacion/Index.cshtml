@page
@model FrontendInnovacionCurricular.Pages.Acreditacion.IndexModel
@{ ViewData["Title"] = "Acreditaciones"; }
<h1>Acreditaciones</h1>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }
<a class="boton" href="/Acreditacion/Crear">+ Nueva acreditación</a>
<table>
    <thead><tr><th>Resolución</th><th>Tipo</th><th>Calificación</th><th>Fecha de inicio</th><th>Fecha de fin</th><th>Programa</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.Resolucion</td><td>@item.Tipo</td><td>@item.Calificacion</td><td>@item.FechaInicio</td><td>@item.FechaFin</td><td>@item.ProgramaNombre</td>
                <td class="acciones">
                    <a href="/Acreditacion/Editar/@item.Resolucion">Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Resolucion" style="display:inline" onsubmit="return confirm('¿Retirar este registro?');">
                        <button type="submit">Retirar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
