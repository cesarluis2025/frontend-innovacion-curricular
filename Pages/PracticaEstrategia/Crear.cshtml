@page
@model FrontendInnovacionCurricular.Pages.PracticaEstrategia.CrearModel
@{ ViewData["Title"] = "Nueva práctica/estrategia"; }
<h1>Nueva práctica / estrategia</h1>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }
<form method="post">
    <div><label asp-for="Registro.Id">ID</label><input asp-for="Registro.Id" type="number" /></div>
    <div><label asp-for="Registro.Tipo">Tipo</label><input asp-for="Registro.Tipo" type="text" maxlength="45" /></div>
    <div><label asp-for="Registro.Nombre">Nombre</label><input asp-for="Registro.Nombre" type="text" maxlength="45" /></div>
    <div><label asp-for="Registro.Descripcion">Descripción</label><input asp-for="Registro.Descripcion" type="text" maxlength="45" /></div>
    <button type="submit">Guardar</button>
    <a class="boton" href="/PracticaEstrategia">Cancelar</a>
</form>
