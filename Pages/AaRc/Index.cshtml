@page
@model FrontendInnovacionCurricular.Pages.AaRc.IndexModel
@{ ViewData["Title"] = "Actividades académicas en registros calificados"; }
<header class="titulo">
    <div class="titulo-txt"><span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-actividad"/></svg></span><h1>Actividades académicas en registros calificados</h1></div>
    <a class="boton principal" href="/AaRc/Crear"><svg class="ico" aria-hidden="true"><use href="#i-mas"/></svg> Nueva asignación de actividad</a>
</header>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error"><svg class="ico" aria-hidden="true"><use href="#i-alerta"/></svg><span>@Model.MensajeError</span></div> }

<div class="tabla">
<table>
    <thead><tr><th>Actividad académica</th><th>Registro calificado</th><th>Componente</th><th>Semestre</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.ActivAcademicaNombre</td><td>@item.RegistroCalificadoNombre</td><td>@item.Componente</td><td>@item.Semestre</td>
                <td class="acciones">
                    <a class="btn-icono" href="/AaRc/Editar/@item.ActivAcademicasIdcurso/@item.RegistroCalificadoCodigo"><svg class="ico" aria-hidden="true"><use href="#i-lapiz"/></svg> Editar</a>
                    <form method="post" asp-page-handler="Retirar" asp-route-a="@item.ActivAcademicasIdcurso" asp-route-b="@item.RegistroCalificadoCodigo" style="display:inline" data-confirmar="¿Retirar esta asignación?">
                        <button type="submit"><svg class="ico" aria-hidden="true"><use href="#i-basura"/></svg> Retirar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
