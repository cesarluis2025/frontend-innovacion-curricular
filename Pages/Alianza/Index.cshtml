@page
@model FrontendInnovacionCurricular.Pages.Alianza.IndexModel
@{ ViewData["Title"] = "Alianzas"; }
<header class="titulo">
    <div class="titulo-txt"><span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-link"/></svg></span><h1>Alianzas</h1></div>
    <a class="boton principal" href="/Alianza/Crear"><svg class="ico" aria-hidden="true"><use href="#i-mas"/></svg> Nueva alianza</a>
</header>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error"><svg class="ico" aria-hidden="true"><use href="#i-alerta"/></svg><span>@Model.MensajeError</span></div> }

<div class="tabla">
<table>
    <thead><tr><th>Aliado</th><th>Programa (departamento)</th><th>Fecha de inicio</th><th>Fecha de fin</th><th>Documento del docente</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.AliadoNombre</td><td>@item.DepartamentoNombre</td><td>@item.FechaInicio.ToString("yyyy-MM-dd")</td><td>@item.FechaFin?.ToString("yyyy-MM-dd")</td><td>@item.Docente</td>
                <td class="acciones">
                    <a class="btn-icono" href="/Alianza/Editar/@item.Aliado/@item.Departamento"><svg class="ico" aria-hidden="true"><use href="#i-lapiz"/></svg> Editar</a>
                    <form method="post" asp-page-handler="Retirar" asp-route-a="@item.Aliado" asp-route-b="@item.Departamento" style="display:inline" data-confirmar="¿Retirar esta asignación?">
                        <button type="submit"><svg class="ico" aria-hidden="true"><use href="#i-basura"/></svg> Retirar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
