@page "{a:int}/{b:int}"
@model FrontendInnovacionCurricular.Pages.Alianza.EditarModel
@{ ViewData["Title"] = "Editar asignación"; }
<h1>Editar asignación</h1>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }
<p>La pareja no se cambia: para asignar otra, se retira esta y se crea una nueva.</p>
<form method="post">
    <div><label>Aliado</label><input value="@Model.Registro.AliadoNombre" type="text" disabled /></div>
    <div><label>Programa (departamento)</label><input value="@Model.Registro.DepartamentoNombre" type="text" disabled /></div>
    <div><label asp-for="Registro.FechaInicio">Fecha de inicio</label><input asp-for="Registro.FechaInicio" type="date" required /></div>
    <div><label asp-for="Registro.FechaFin">Fecha de fin</label><input asp-for="Registro.FechaFin" type="date" /></div>
    <div><label asp-for="Registro.Docente">Documento del docente</label><input asp-for="Registro.Docente" type="number" /></div>
    <div class="barra">
        <button type="submit">Actualizar</button>
        <a class="boton" href="/Alianza">Cancelar</a>
    </div>
</form>
