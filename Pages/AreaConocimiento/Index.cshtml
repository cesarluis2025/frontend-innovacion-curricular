@page
@model FrontendInnovacionCurricular.Pages.AreaConocimiento.IndexModel
@{ ViewData["Title"] = "Área de conocimiento"; }

<header class="titulo">
    <div class="titulo-txt"><span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-globo"/></svg></span><h1>Área de conocimiento</h1></div>
    <a class="boton principal" href="/AreaConocimiento/Crear"><svg class="ico" aria-hidden="true"><use href="#i-mas"/></svg> Nuevo registro</a>
</header>


<div class="tabla">
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Gran área</th>
            <th>Área</th>
            <th>Disciplina</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.GranArea</td>
                <td>@item.Area</td>
                <td>@item.Disciplina</td>
                <td class="acciones">
                    <a class="btn-icono" href="/AreaConocimiento/Editar/@item.Id"><svg class="ico" aria-hidden="true"><use href="#i-lapiz"/></svg> Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Id"
                          style="display:inline"
                          data-confirmar="¿Retirar este registro?">
                        <button type="submit"><svg class="ico" aria-hidden="true"><use href="#i-basura"/></svg> Retirar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
