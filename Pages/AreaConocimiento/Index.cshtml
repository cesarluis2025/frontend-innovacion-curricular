@page
@model FrontendInnovacionCurricular.Pages.AreaConocimiento.IndexModel
@{ ViewData["Title"] = "Área de conocimiento"; }

<h1>Área de conocimiento</h1>
<a class="boton" href="/AreaConocimiento/Crear">+ Nuevo registro</a>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Gran área</th>
            <th>Área</th>
            <th>Disciplina</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.GranArea</td>
                <td>@item.Area</td>
                <td>@item.Disciplina</td>
                <td class="acciones">
                    <a href="/AreaConocimiento/Editar/@item.Id">Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Id"
                          style="display:inline"
                          onsubmit="return confirm('¿Eliminar este registro?');">
                        <button type="submit">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
