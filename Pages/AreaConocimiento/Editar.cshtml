@page "{id:int}"
@model FrontendInnovacionCurricular.Pages.AreaConocimiento.EditarModel
@{ ViewData["Title"] = "Editar área de conocimiento"; }

<h1>Editar área de conocimiento #@Model.Registro.Id</h1>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="error">@Model.MensajeError</div>
}

<form method="post">
    <div>
        <label>ID</label>
        <input value="@Model.Registro.Id" type="number" disabled />
        <!-- el id no se edita: es la llave primaria -->
    </div>
    <div>
        <label asp-for="Registro.GranArea">Gran área</label>
        <input asp-for="Registro.GranArea" type="text" maxlength="60" />
    </div>
    <div>
        <label asp-for="Registro.Area">Área</label>
        <input asp-for="Registro.Area" type="text" maxlength="60" />
    </div>
    <div>
        <label asp-for="Registro.Disciplina">Disciplina</label>
        <input asp-for="Registro.Disciplina" type="text" maxlength="60" />
    </div>
    <div class="barra">
        <button type="submit"><svg class="ico" aria-hidden="true"><use href="#i-guardar"/></svg> Actualizar</button>
        <a class="boton" href="/AreaConocimiento"><svg class="ico" aria-hidden="true"><use href="#i-atras"/></svg> Cancelar</a>
    </div>
</form>
