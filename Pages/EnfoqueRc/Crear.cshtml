@page
@model FrontendInnovacionCurricular.Pages.EnfoqueRc.CrearModel
@{ ViewData["Title"] = "Nueva asignación de enfoque"; }
<h1>Nueva asignación de enfoque</h1>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }
<form method="post">
    <div><label asp-for="Registro.Enfoque">Enfoque</label><select asp-for="Registro.Enfoque" asp-items="Model.ListaEnfoque" required><option value="">Seleccione…</option></select></div>
    <div><label asp-for="Registro.RegistroCalificado">Registro calificado</label><select asp-for="Registro.RegistroCalificado" asp-items="Model.ListaRegistroCalificado" required><option value="">Seleccione…</option></select></div>
    <button type="submit">Guardar</button>
    <a class="boton" href="/EnfoqueRc">Cancelar</a>
</form>
