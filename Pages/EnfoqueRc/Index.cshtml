@page
@model FrontendInnovacionCurricular.Pages.EnfoqueRc.IndexModel
@{ ViewData["Title"] = "Enfoques de los registros calificados"; }
<h1>Enfoques de los registros calificados</h1>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }
<a class="boton" href="/EnfoqueRc/Crear">+ Nueva asignación de enfoque</a>
<table>
    <thead><tr><th>Enfoque</th><th>Registro calificado</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.EnfoqueNombre</td><td>@item.RegistroCalificadoNombre</td>
                <td class="acciones">
                    
                    <form method="post" asp-page-handler="Retirar" asp-route-a="@item.Enfoque" asp-route-b="@item.RegistroCalificado" style="display:inline" onsubmit="return confirm('¿Retirar esta asignación?');">
                        <button type="submit">Retirar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
