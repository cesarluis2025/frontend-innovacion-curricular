@page
@model FrontendInnovacionCurricular.Pages.ProgramaCi.IndexModel
@{ ViewData["Title"] = "Programas y características de innovación"; }
<header class="titulo">
    <div class="titulo-txt"><span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-bombillo"/></svg></span><h1>Programas y características de innovación</h1></div>
    <a class="boton principal" href="/ProgramaCi/Crear"><svg class="ico" aria-hidden="true"><use href="#i-mas"/></svg> Nueva asignación de característica</a>
</header>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error"><svg class="ico" aria-hidden="true"><use href="#i-alerta"/></svg><span>@Model.MensajeError</span></div> }

<div class="tabla">
<table>
    <thead><tr><th>Programa</th><th>Característica de innovación</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.ProgramaNombre</td><td>@item.CarInnovacionNombre</td>
                <td class="acciones">
                    
                    <form method="post" asp-page-handler="Retirar" asp-route-a="@item.Programa" asp-route-b="@item.CarInnovacion" style="display:inline" data-confirmar="¿Retirar esta asignación?">
                        <button type="submit"><svg class="ico" aria-hidden="true"><use href="#i-basura"/></svg> Retirar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
