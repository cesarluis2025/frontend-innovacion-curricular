@page
@model FrontendInnovacionCurricular.Pages.DocenteDepartamento.IndexModel
@{ ViewData["Title"] = "Docentes por programa"; }
<header class="titulo">
    <h1>Docentes por programa</h1>
    <a class="boton principal" href="/DocenteDepartamento/Crear">+ Nueva asignación de docente</a>
</header>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }

<div class="tabla">
<table>
    <thead><tr><th>Documento del docente</th><th>Programa (departamento)</th><th>Dedicación</th><th>Modalidad</th><th>Fecha de ingreso</th><th>Fecha de salida</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.Docente</td><td>@item.DepartamentoNombre</td><td>@item.Dedicacion</td><td>@item.Modalidad</td><td>@item.FechaIngreso.ToString("yyyy-MM-dd")</td><td>@item.FechaSalida?.ToString("yyyy-MM-dd")</td>
                <td class="acciones">
                    <a href="/DocenteDepartamento/Editar/@item.Docente/@item.Departamento">Editar</a>
                    <form method="post" asp-page-handler="Retirar" asp-route-a="@item.Docente" asp-route-b="@item.Departamento" style="display:inline" onsubmit="return confirm('¿Retirar esta asignación?');">
                        <button type="submit">Retirar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
