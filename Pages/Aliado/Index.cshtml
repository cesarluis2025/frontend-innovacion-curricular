@page
@model FrontendInnovacionCurricular.Pages.Aliado.IndexModel
@{ ViewData["Title"] = "Aliado"; }
<h1>Aliado</h1>
<a class="boton boton-primario" href="/Aliado/Crear">+ Nuevo registro</a>
<table>
    <thead><tr><th>NIT</th><th>Razón social</th><th>Contacto</th><th>Correo</th><th>Teléfono</th><th>Ciudad</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.Nit</td><td>@item.RazonSocial</td><td>@item.NombreContacto</td>
                <td>@item.Correo</td><td>@item.Telefono</td><td>@item.Ciudad</td>
                <td class="acciones">
                    <a href="/Aliado/Editar/@item.Nit">Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-nit="@item.Nit" style="display:inline" onsubmit="return confirm('¿Eliminar este registro?');">
                        <button type="submit">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
