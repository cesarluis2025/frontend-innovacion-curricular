@page
@model FrontendInnovacionCurricular.Pages.Aliado.IndexModel
@{ ViewData["Title"] = "Aliado"; }
<header class="titulo">
    <div class="titulo-txt"><span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-aliado"/></svg></span><h1>Aliado</h1></div>
    <a class="boton principal" href="/Aliado/Crear"><svg class="ico" aria-hidden="true"><use href="#i-mas"/></svg> Nuevo registro</a>
</header>

<div class="tabla">
<table>
    <thead><tr><th>NIT</th><th>Razón social</th><th>Contacto</th><th>Correo</th><th>Teléfono</th><th>Ciudad</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.Nit</td><td>@item.RazonSocial</td><td>@item.NombreContacto</td>
                <td>@item.Correo</td><td>@item.Telefono</td><td>@item.Ciudad</td>
                <td class="acciones">
                    <a class="btn-icono" href="/Aliado/Editar/@item.Nit"><svg class="ico" aria-hidden="true"><use href="#i-lapiz"/></svg> Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-nit="@item.Nit" style="display:inline" data-confirmar="¿Retirar este registro?">
                        <button type="submit"><svg class="ico" aria-hidden="true"><use href="#i-basura"/></svg> Retirar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
