@page
@model FrontendInnovacionCurricular.Pages.RegistroCalificado.CrearModel
@{ ViewData["Title"] = "Nuevo registro calificado"; }
<h1>Nuevo registro calificado</h1>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error"><svg class="ico" aria-hidden="true"><use href="#i-alerta"/></svg><span>@Model.MensajeError</span></div> }
<form method="post">
    <div><label asp-for="Registro.Codigo">Código</label><input asp-for="Registro.Codigo" type="number" required /></div>
    <div><label asp-for="Registro.CantCreditos">Cantidad de créditos</label><input asp-for="Registro.CantCreditos" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.HoraAcom">Horas con acompañamiento</label><input asp-for="Registro.HoraAcom" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.HoraInd">Horas independientes</label><input asp-for="Registro.HoraInd" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.Metodologia">Metodología</label><input asp-for="Registro.Metodologia" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.FechaInicio">Fecha de inicio</label><input asp-for="Registro.FechaInicio" type="date" required /></div>
    <div><label asp-for="Registro.FechaFin">Fecha de fin</label><input asp-for="Registro.FechaFin" type="date" required /></div>
    <div><label asp-for="Registro.DuracionAnios">Duración (años)</label><input asp-for="Registro.DuracionAnios" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.DuracionSemestres">Duración (semestres)</label><input asp-for="Registro.DuracionSemestres" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.TipoTitulacion">Tipo de titulación</label><input asp-for="Registro.TipoTitulacion" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.Programa">Programa</label><select asp-for="Registro.Programa" asp-items="Model.ListaPrograma" required><option value="">Seleccione…</option></select></div>
    <div class="barra">
        <button type="submit"><svg class="ico" aria-hidden="true"><use href="#i-guardar"/></svg> Guardar</button>
        <a class="boton" href="/RegistroCalificado"><svg class="ico" aria-hidden="true"><use href="#i-atras"/></svg> Cancelar</a>
    </div>
</form>
