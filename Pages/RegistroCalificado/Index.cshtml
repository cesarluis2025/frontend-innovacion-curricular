@page
@model FrontendInnovacionCurricular.Pages.RegistroCalificado.IndexModel
@{ ViewData["Title"] = "Registros calificados"; }
<header class="titulo">
    <div class="titulo-txt"><span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-registro"/></svg></span><h1>Registros calificados</h1></div>
    <a class="boton principal" href="/RegistroCalificado/Crear"><svg class="ico" aria-hidden="true"><use href="#i-mas"/></svg> Nuevo registro calificado</a>
</header>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error"><svg class="ico" aria-hidden="true"><use href="#i-alerta"/></svg><span>@Model.MensajeError</span></div> }

<div class="tabla">
<table>
    <thead><tr><th>Código</th><th>Metodología</th><th>Fecha de inicio</th><th>Fecha de fin</th><th>Tipo de titulación</th><th>Programa</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.Codigo</td><td>@item.Metodologia</td><td>@item.FechaInicio.ToString("yyyy-MM-dd")</td><td>@item.FechaFin.ToString("yyyy-MM-dd")</td><td>@item.TipoTitulacion</td><td>@item.ProgramaNombre</td>
                <td class="acciones">
                    <a class="btn-icono" href="/RegistroCalificado/Editar/@item.Codigo"><svg class="ico" aria-hidden="true"><use href="#i-lapiz"/></svg> Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Codigo" style="display:inline" data-confirmar="¿Retirar este registro?">
                        <button type="submit"><svg class="ico" aria-hidden="true"><use href="#i-basura"/></svg> Retirar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
