@page
@model FrontendInnovacionCurricular.Pages.RegistroCalificado.IndexModel
@{ ViewData["Title"] = "Registros calificados"; }
<header class="titulo">
    <h1>Registros calificados</h1>
    <a class="boton principal" href="/RegistroCalificado/Crear">+ Nuevo registro calificado</a>
</header>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }

<div class="tabla">
<table>
    <thead><tr><th>Código</th><th>Metodología</th><th>Fecha de inicio</th><th>Fecha de fin</th><th>Tipo de titulación</th><th>Programa</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.Codigo</td><td>@item.Metodologia</td><td>@item.FechaInicio.ToString("yyyy-MM-dd")</td><td>@item.FechaFin.ToString("yyyy-MM-dd")</td><td>@item.TipoTitulacion</td><td>@item.ProgramaNombre</td>
                <td class="acciones">
                    <a href="/RegistroCalificado/Editar/@item.Codigo">Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Codigo" style="display:inline" onsubmit="return confirm('¿Retirar este registro?');">
                        <button type="submit">Retirar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
