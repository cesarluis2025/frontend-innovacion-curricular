@page
@model FrontendInnovacionCurricular.Pages.ProgramaPe.IndexModel
@{ ViewData["Title"] = "Programas y prácticas o estrategias"; }
<header class="titulo">
    <h1>Programas y prácticas o estrategias</h1>
    <a class="boton principal" href="/ProgramaPe/Crear">+ Nueva asignación de práctica</a>
</header>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }

<div class="tabla">
<table>
    <thead><tr><th>Programa</th><th>Práctica o estrategia</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.ProgramaNombre</td><td>@item.PracticaEstrategiaNombre</td>
                <td class="acciones">
                    
                    <form method="post" asp-page-handler="Retirar" asp-route-a="@item.Programa" asp-route-b="@item.PracticaEstrategia" style="display:inline" onsubmit="return confirm('¿Retirar esta asignación?');">
                        <button type="submit">Retirar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
