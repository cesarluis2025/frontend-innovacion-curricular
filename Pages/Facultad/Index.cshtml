@page
@model FrontendInnovacionCurricular.Pages.Facultad.IndexModel
@{ ViewData["Title"] = "Facultades"; }
<header class="titulo">
    <h1>Facultades</h1>
    <a class="boton principal" href="/Facultad/Crear">+ Nueva facultad</a>
</header>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }

<div class="tabla">
<table>
    <thead><tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Universidad</th><th>Programas activos</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.Id</td><td>@item.Nombre</td><td>@item.Tipo</td><td>@item.UniversidadNombre</td><td>@item.TotalProgramas</td>
                <td class="acciones">
                    <a href="/Facultad/Detalle/@item.Id">Detalle</a>
                    <a href="/Facultad/Editar/@item.Id">Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Id" style="display:inline" onsubmit="return confirm('¿Retirar este registro?');">
                        <button type="submit">Retirar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
