@page
@model FrontendInnovacionCurricular.Pages.Facultad.IndexModel
@{ ViewData["Title"] = "Facultades"; }
<header class="titulo">
    <div class="titulo-txt"><span class="chip"><svg class="ico" aria-hidden="true"><use href="#i-facultad"/></svg></span><h1>Facultades</h1></div>
    <a class="boton principal" href="/Facultad/Crear"><svg class="ico" aria-hidden="true"><use href="#i-mas"/></svg> Nueva facultad</a>
</header>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error"><svg class="ico" aria-hidden="true"><use href="#i-alerta"/></svg><span>@Model.MensajeError</span></div> }

<div class="tabla">
<table>
    <thead><tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Universidad</th><th>Programas activos</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model.Registros)
        {
            <tr>
                <td>@item.Id</td><td>@item.Nombre</td><td>@item.Tipo</td><td>@item.UniversidadNombre</td><td>@item.TotalProgramas</td>
                <td class="acciones">
                    <a class="btn-icono" href="/Facultad/Detalle/@item.Id"><svg class="ico" aria-hidden="true"><use href="#i-ojo"/></svg> Detalle</a>
                    <a class="btn-icono" href="/Facultad/Editar/@item.Id"><svg class="ico" aria-hidden="true"><use href="#i-lapiz"/></svg> Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Id" style="display:inline" data-confirmar="¿Retirar este registro?">
                        <button type="submit"><svg class="ico" aria-hidden="true"><use href="#i-basura"/></svg> Retirar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
