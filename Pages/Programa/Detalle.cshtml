    </form>
</section>
<section>
    <h2>Premios</h2>
    @if (Model.Premios.Count == 0) { <p>Todavía no hay registros.</p> }
    else
    {
        <table>
            <thead><tr><th>Código</th><th>Nombre</th><th>Fecha</th><th>Entidad que lo otorga</th><th>País</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Premios)
                {
                    <tr><td>@item.Id</td><td>@item.Nombre</td><td>@item.Fecha.ToString("yyyy-MM-dd")</td><td>@item.EntidadOtorgante</td><td>@item.Pais</td></tr>
                }
            </tbody>
        </table>
    }
    <h3>Agregar varias filas</h3>
    @if (Model.SeccionConError == "Premios" && !string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }
    <form method="post" asp-page-handler="Premios" asp-route-id="@Model.Maestro.Id">
        <table id="tablaPremios" class="filas">
            <thead><tr><th>Código</th><th>Nombre</th><th>Descripción</th><th>Fecha</th><th>Entidad que lo otorga</th><th>País</th></tr></thead>
            <tbody>
                @for (var i = 0; i < Model.NuevasPremios.Count; i++)
                {
                    <tr><td><input asp-for="NuevasPremios[i].Id" type="number" /></td><td><input asp-for="NuevasPremios[i].Nombre" type="text" maxlength="45" /></td><td><input asp-for="NuevasPremios[i].Descripcion" type="text" maxlength="45" /></td><td><input asp-for="NuevasPremios[i].Fecha" type="date" /></td><td><input asp-for="NuevasPremios[i].EntidadOtorgante" type="text" maxlength="45" /></td><td><input asp-for="NuevasPremios[i].Pais" type="text" maxlength="45" /></td></tr>
                }
