@page "{id:int}"
@model FrontendInnovacionCurricular.Pages.Programa.DetalleModel
@{ ViewData["Title"] = "Detalle"; }
<h1>@Model.Maestro.Nombre</h1>
<p><a href="/Programa">← Volver a la lista</a></p>
@if (TempData["Ok"] is string ok) { <div class="ok">@ok</div> }

<section>
    <h2>Acreditaciones</h2>
    @if (Model.Acreditaciones.Count == 0) { <p>Todavía no hay registros.</p> }
    else
    {
        <table>
            <thead><tr><th>Resolución</th><th>Tipo</th><th>Calificación</th><th>Fecha de inicio</th><th>Fecha de fin</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Acreditaciones)
                {
                    <tr><td>@item.Resolucion</td><td>@item.Tipo</td><td>@item.Calificacion</td><td>@item.FechaInicio</td><td>@item.FechaFin</td></tr>
                }
            </tbody>
        </table>
    }
    <h3>Agregar varias filas</h3>
    @if (Model.SeccionConError == "Acreditaciones" && !string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }
    <form method="post" asp-page-handler="Acreditaciones" asp-route-id="@Model.Maestro.Id">
        <table id="tablaAcreditaciones" class="filas">
            <thead><tr><th>Resolución</th><th>Tipo</th><th>Calificación</th><th>Fecha de inicio</th><th>Fecha de fin</th></tr></thead>
            <tbody>
                @for (var i = 0; i < Model.NuevasAcreditaciones.Count; i++)
                {
                    <tr><td><input asp-for="NuevasAcreditaciones[i].Resolucion" type="number" /></td><td><input asp-for="NuevasAcreditaciones[i].Tipo" type="text" maxlength="45" /></td><td><input asp-for="NuevasAcreditaciones[i].Calificacion" type="text" maxlength="45" /></td><td><input asp-for="NuevasAcreditaciones[i].FechaInicio" type="text" maxlength="45" /></td><td><input asp-for="NuevasAcreditaciones[i].FechaFin" type="text" maxlength="45" /></td></tr>
                }
            </tbody>
        </table>
        <button type="button" class="agregar-fila" data-tabla="tablaAcreditaciones">+ Agregar fila</button>
        <button type="submit">Guardar todas las filas</button>
    </form>
</section>
<section>
    <h2>Registros calificados</h2>
    @if (Model.RegistrosCalificados.Count == 0) { <p>Todavía no hay registros.</p> }
    else
    {
        <table>
            <thead><tr><th>Código</th><th>Metodología</th><th>Fecha de inicio</th><th>Fecha de fin</th><th>Tipo de titulación</th></tr></thead>
            <tbody>
                @foreach (var item in Model.RegistrosCalificados)
                {
                    <tr><td>@item.Codigo</td><td>@item.Metodologia</td><td>@item.FechaInicio.ToString("yyyy-MM-dd")</td><td>@item.FechaFin.ToString("yyyy-MM-dd")</td><td>@item.TipoTitulacion</td></tr>
                }
            </tbody>
        </table>
    }
    <h3>Agregar varias filas</h3>
    @if (Model.SeccionConError == "RegistrosCalificados" && !string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }
    <form method="post" asp-page-handler="RegistrosCalificados" asp-route-id="@Model.Maestro.Id">
        <table id="tablaRegistrosCalificados" class="filas">
            <thead><tr><th>Código</th><th>Cantidad de créditos</th><th>Horas con acompañamiento</th><th>Horas independientes</th><th>Metodología</th><th>Fecha de inicio</th><th>Fecha de fin</th><th>Duración (años)</th><th>Duración (semestres)</th><th>Tipo de titulación</th></tr></thead>
            <tbody>
                @for (var i = 0; i < Model.NuevasRegistrosCalificados.Count; i++)
                {
                    <tr><td><input asp-for="NuevasRegistrosCalificados[i].Codigo" type="number" /></td><td><input asp-for="NuevasRegistrosCalificados[i].CantCreditos" type="text" maxlength="45" /></td><td><input asp-for="NuevasRegistrosCalificados[i].HoraAcom" type="text" maxlength="45" /></td><td><input asp-for="NuevasRegistrosCalificados[i].HoraInd" type="text" maxlength="45" /></td><td><input asp-for="NuevasRegistrosCalificados[i].Metodologia" type="text" maxlength="45" /></td><td><input asp-for="NuevasRegistrosCalificados[i].FechaInicio" type="date" /></td><td><input asp-for="NuevasRegistrosCalificados[i].FechaFin" type="date" /></td><td><input asp-for="NuevasRegistrosCalificados[i].DuracionAnios" type="text" maxlength="45" /></td><td><input asp-for="NuevasRegistrosCalificados[i].DuracionSemestres" type="text" maxlength="45" /></td><td><input asp-for="NuevasRegistrosCalificados[i].TipoTitulacion" type="text" maxlength="45" /></td></tr>
                }
            </tbody>
        </table>
        <button type="button" class="agregar-fila" data-tabla="tablaRegistrosCalificados">+ Agregar fila</button>
        <button type="submit">Guardar todas las filas</button>
    </form>
</section>
<section>
    <h2>Actividades académicas</h2>
    @if (Model.ActividadesAcademicas.Count == 0) { <p>Todavía no hay registros.</p> }
    else
    {
        <table>
            <thead><tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Número de créditos</th><th>Idioma</th></tr></thead>
            <tbody>
                @foreach (var item in Model.ActividadesAcademicas)
                {
                    <tr><td>@item.Id</td><td>@item.Nombre</td><td>@item.Tipo</td><td>@item.NumCreditos</td><td>@item.Idioma</td></tr>
                }
            </tbody>
        </table>
    }
    <h3>Agregar varias filas</h3>
    @if (Model.SeccionConError == "ActividadesAcademicas" && !string.IsNullOrEmpty(Model.MensajeError)) { <div class="error">@Model.MensajeError</div> }
    <form method="post" asp-page-handler="ActividadesAcademicas" asp-route-id="@Model.Maestro.Id">
        <table id="tablaActividadesAcademicas" class="filas">
            <thead><tr><th>Código</th><th>Nombre</th><th>Número de créditos</th><th>Tipo</th><th>Área de formación</th><th>Horas con acompañamiento</th><th>Horas independientes</th><th>Idioma</th><th>¿Es una actividad espejo?</th><th>Entidad espejo</th><th>País espejo</th></tr></thead>
            <tbody>
                @for (var i = 0; i < Model.NuevasActividadesAcademicas.Count; i++)
                {
                    <tr><td><input asp-for="NuevasActividadesAcademicas[i].Id" type="number" /></td><td><input asp-for="NuevasActividadesAcademicas[i].Nombre" type="text" maxlength="45" /></td><td><input asp-for="NuevasActividadesAcademicas[i].NumCreditos" type="number" /></td><td><input asp-for="NuevasActividadesAcademicas[i].Tipo" type="text" maxlength="20" /></td><td><input asp-for="NuevasActividadesAcademicas[i].AreaFormacion" type="text" maxlength="45" /></td><td><input asp-for="NuevasActividadesAcademicas[i].HAcom" type="number" /></td><td><input asp-for="NuevasActividadesAcademicas[i].HIndep" type="number" /></td><td><input asp-for="NuevasActividadesAcademicas[i].Idioma" type="text" maxlength="45" /></td><td><select asp-for="NuevasActividadesAcademicas[i].Espejo" class="espejo"><option value="0">No</option><option value="1">Sí</option></select></td><td><input asp-for="NuevasActividadesAcademicas[i].EntidadEspejo" type="text" maxlength="45" class="espejo-dep" /></td><td><input asp-for="NuevasActividadesAcademicas[i].PaisEspejo" type="text" maxlength="45" class="espejo-dep" /></td></tr>
                }
            </tbody>
        </table>
        <button type="button" class="agregar-fila" data-tabla="tablaActividadesAcademicas">+ Agregar fila</button>
        <button type="submit">Guardar todas las filas</button>
    </form>
</section>
