                    <tr><td><input asp-for="NuevasPasantias[i].Id" type="number" /></td><td><input asp-for="NuevasPasantias[i].Nombre" type="text" maxlength="45" /></td><td><input asp-for="NuevasPasantias[i].Pais" type="text" maxlength="45" /></td><td><input asp-for="NuevasPasantias[i].Empresa" type="text" maxlength="45" /></td><td><input asp-for="NuevasPasantias[i].Descripcion" type="text" maxlength="45" /></td></tr>
                }
            </tbody>
        </table>
        <button type="button" class="agregar-fila" data-tabla="tablaPasantias">+ Agregar fila</button>
