@page
@model FrontendInnovacionCurricular.Pages.Programa.CrearModel
@{ ViewData["Title"] = "Nuevo programa"; }
<h1>Nuevo programa</h1>
@if (!string.IsNullOrEmpty(Model.MensajeError)) { <div class="error"><svg class="ico" aria-hidden="true"><use href="#i-alerta"/></svg><span>@Model.MensajeError</span></div> }
<form method="post">
    <div><label asp-for="Registro.Id">Código</label><input asp-for="Registro.Id" type="number" required /></div>
    <div><label asp-for="Registro.Nombre">Nombre</label><input asp-for="Registro.Nombre" type="text" maxlength="100" required /></div>
    <div><label asp-for="Registro.Tipo">Tipo</label><input asp-for="Registro.Tipo" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.Nivel">Nivel</label><input asp-for="Registro.Nivel" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.FechaCreacion">Fecha de creación</label><input asp-for="Registro.FechaCreacion" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.FechaCierre">Fecha de cierre</label><input asp-for="Registro.FechaCierre" type="text" maxlength="45" /></div>
    <div><label asp-for="Registro.NumeroCohortes">Número de cohortes</label><input asp-for="Registro.NumeroCohortes" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.CantGraduados">Cantidad de graduados</label><input asp-for="Registro.CantGraduados" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.FechaActualizacion">Fecha de actualización</label><input asp-for="Registro.FechaActualizacion" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.Ciudad">Ciudad</label><input asp-for="Registro.Ciudad" type="text" maxlength="45" required /></div>
    <div><label asp-for="Registro.Facultad">Facultad</label><select asp-for="Registro.Facultad" asp-items="Model.ListaFacultad" required><option value="">Seleccione…</option></select></div>
    <div class="barra">
        <button type="submit"><svg class="ico" aria-hidden="true"><use href="#i-guardar"/></svg> Guardar</button>
        <a class="boton" href="/Programa"><svg class="ico" aria-hidden="true"><use href="#i-atras"/></svg> Cancelar</a>
    </div>
</form>
